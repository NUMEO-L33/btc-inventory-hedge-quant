# ---------------------------------------------------------------
# BTC Inventory Hedge Quant - environment variables (example)
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------

# Exchange API credentials (COIN-M futures). Create a dedicated sub-account.
# Required permissions: "Enable Futures". Withdrawals MUST be disabled. Set an IP whitelist.
BIQ_BINANCE_API_KEY=
BIQ_BINANCE_API_SECRET=

# Demo / testnet credentials (separate keys from production)
BIQ_BINANCE_DEMO_API_KEY=
BIQ_BINANCE_DEMO_API_SECRET=

# Hard gate for live trading. Live orders are refused unless this is exactly "true"
# AND configs/live.yaml has live_trading_enabled: true AND the CLI is run with --confirm-live
# AND the acknowledgement string matches.
BIQ_ENABLE_LIVE_TRADING=false
BIQ_LIVE_ACKNOWLEDGEMENT=

# Storage (SQLite for local development, PostgreSQL for operations)
BIQ_DATABASE_URL=sqlite:///state/biq.sqlite3
# BIQ_DATABASE_URL=postgresql+psycopg://biq:biq@localhost:5432/biq

# Alerts (optional; failures never stop trading logic)
BIQ_TELEGRAM_BOT_TOKEN=
BIQ_TELEGRAM_CHAT_ID=
BIQ_SMTP_HOST=
BIQ_SMTP_PORT=587
BIQ_SMTP_USER=
BIQ_SMTP_PASSWORD=
BIQ_ALERT_EMAIL_TO=

# Logging
BIQ_LOG_LEVEL=INFO
BIQ_LOG_JSON=true
